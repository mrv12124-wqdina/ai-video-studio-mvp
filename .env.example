# AI and media provider credentials
# Copy this file locally to .env.local. Never commit real credentials.

# Generic video provider: server-side POST JSON endpoint.
# The app sends {prompt, aspect_ratio, duration, reference_images}
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_API_KEY_HEADER=Authorization
VIDEO_API_KEY_PREFIX=Bearer 

# Optional Pexels stock search
PEXELS_API_KEY=

# Optional ElevenLabs speech API
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional object storage for production
PUBLIC_VIDEO_BASE_URL=
